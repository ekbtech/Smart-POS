NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# For a deployed frontend and API on different origins, set these to their public HTTPS URLs:
# VITE_API_BASE_URL=https://api.example.com/api
# VITE_PUBLIC_APP_URL=https://pos.example.com
DATABASE_URL=mysql://smart pos_app:replace-with-a-local-password@127.0.0.1:3306/smart_pos
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL=8h
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-before-seeding
SEED_ADMIN_NAME=System Administrator
