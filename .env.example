NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# For a deployed frontend and API on different origins, set these to their public HTTPS URLs:
# VITE_API_BASE_URL=https://api.example.com/api
# VITE_PUBLIC_APP_URL=https://pos.example.com
DATABASE_URL=mysql://smart pos_app:replace-with-a-local-password@127.0.0.1:3306/smart_pos
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL=8h
# Cashier monitor presence thresholds. POS heartbeats are sent every 20 seconds.
CASHIER_PRESENCE_TIMEOUT_SECONDS=90
CASHIER_IDLE_TIMEOUT_SECONDS=300
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-before-seeding
SEED_ADMIN_NAME=System Administrator
# Set false to create the initial admin without inserting sample products.
SEED_SAMPLE_PRODUCTS=true

# Configure Daraja values only in the server environment; never put them in VITE_* variables.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=https://api.example.com/api/mpesa/callback

RECEIPT_BUSINESS_NAME=Checonex
RECEIPT_BUSINESS_PHONE=0723037557
RECEIPT_BUSINESS_ADDRESS=Eldama Ravine / Kabarnet
RECEIPT_LOGO_URL=

# Enterprise feature configuration
BACKUP_STORAGE_DIR=/var/backups/smart-pos
BACKUP_ENCRYPTION_KEY=replace-with-a-random-32-byte-or-longer-secret
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Use an approved WhatsApp template with body variables {{1}} branch, {{2}} receipt,
# {{3}} total, and {{4}} cashier; template must be submitted and approved by Meta.
WHATSAPP_RECEIPT_TEMPLATE_NAME=
WHATSAPP_RECEIPT_TEMPLATE_LANGUAGE=en
